# Public testnet configuration. Copy to web/.env.local for local web development.
NEXT_PUBLIC_CHAIN_ID=133
NEXT_PUBLIC_RPC_URL=https://testnet.hsk.xyz
# The explorer RPC handles reads when the official public RPC is rate-limited.
NEXT_PUBLIC_READ_RPC_URL=https://testnet-explorer.hskchain.net/api/eth-rpc
NEXT_PUBLIC_TOKEN_ADDRESS=0x41c4986C36Af380d0E5Ba910Bd04947574918ca8
NEXT_PUBLIC_ESCROW_ADDRESS=0x989c71426552fF963e2A6647c05565003A922ff5
NEXT_PUBLIC_SERVICE_URL=/api
# Generate independent random 32-byte hex values; keep both server-side only.
AUTH_SECRET=
SERVICE_PROXY_SECRET=
SNAPSHOT_KEY=
SERVICE_UPSTREAM_URL=http://localhost:8787
# The current deployment's service is routed through the existing tunnel.
SERVICE_UPSTREAM_PREFIX=/v2
